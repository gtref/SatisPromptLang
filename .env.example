# SatisPromptLang AI Model & Agent Configuration
# Supports Groq, Ollama, OpenAI, Anthropic, Gemini, LocalAI, vLLM, and any custom model server.

# Active Provider: groq | ollama | openai | anthropic | gemini | generic
AGENT=ollama

# API Endpoint URL
# - Groq:      https://api.groq.com/openai/v1
# - Ollama:    http://localhost:11434  (no API key needed)
# - OpenAI:    https://api.openai.com/v1
# - Anthropic: https://api.anthropic.com/v1
# - Gemini:    https://generativelanguage.googleapis.com/v1beta
# - LocalAI / LM Studio / vLLM: http://localhost:1234/v1
API_URL=http://localhost:11434

# API Key (leave empty for Ollama or local model servers)
# For Groq: set your gsk_... key
API_KEY=

# Model Name (Supports ANY model)
# - Groq:      llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# - Ollama:    llama3, codellama, mistral, qwen2.5, deepseek-coder
# - OpenAI:    gpt-4o, gpt-4o-mini, o1
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - Gemini:    gemini-1.5-pro, gemini-1.5-flash
MODEL=llama3

# Optional generation settings
TEMPERATURE=0.7
MAX_TOKENS=4096

# ========================================================
# Named Presets (Optional) - select using --agent <name> or shortcut flags (--groq, --ollama, etc.)
# ========================================================

# Groq High-Speed API
AGENT_GROQ_TYPE=groq
AGENT_GROQ_API_URL=https://api.groq.com/openai/v1
# AGENT_GROQ_API_KEY=gsk_...
AGENT_GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Server (No key needed)
AGENT_OLLAMA_TYPE=ollama
AGENT_OLLAMA_API_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=llama3

# OpenAI
# AGENT_OPENAI_TYPE=openai
# AGENT_OPENAI_API_URL=https://api.openai.com/v1
# AGENT_OPENAI_API_KEY=sk-...
# AGENT_OPENAI_MODEL=gpt-4o

# Anthropic
# AGENT_ANTHROPIC_TYPE=anthropic
# AGENT_ANTHROPIC_API_URL=https://api.anthropic.com/v1
# AGENT_ANTHROPIC_API_KEY=sk-ant-...
# AGENT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini
# AGENT_GEMINI_TYPE=gemini
# AGENT_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# AGENT_GEMINI_API_KEY=AIza...
# AGENT_GEMINI_MODEL=gemini-1.5-flash
